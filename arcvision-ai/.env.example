# ArcVision AI — environment template
# انسخ هذا الملف إلى .env

# -------- Database --------
POSTGRES_DB=arcvision
POSTGRES_USER=arcvision
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+psycopg://arcvision:change_me_in_production@postgres:5432/arcvision

# -------- Redis --------
REDIS_URL=redis://redis:6379/0

# -------- Object Storage (MinIO / S3) --------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=arcvision-documents
S3_REGION=me-south-1

# -------- Auth --------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars_____________
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# -------- App --------
APP_ENV=development
APP_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# -------- AI providers (optional in MVP) --------
# عند تركها فارغة، PDF worker يستخدم وضع OCR-only + heuristics
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VISION_MODEL=gpt-4o
TEXT_MODEL=claude-3-5-sonnet-latest

# -------- Frontend --------
NEXT_PUBLIC_API_URL=http://localhost:8000
