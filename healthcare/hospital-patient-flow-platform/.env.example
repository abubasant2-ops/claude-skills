# Copy to .env and fill in. Never commit the filled version.

# --- Database -------------------------------------------------------
# SQLite is fine for local development and the test suite.
HPF_DATABASE_URL=sqlite+pysqlite:///./hpf.db
# Production:
# HPF_DATABASE_URL=postgresql+psycopg://hpf:PASSWORD@db:5432/hpf

# --- Environment ----------------------------------------------------
HPF_ENVIRONMENT=development       # development | test | staging | production
HPF_DEBUG=false

# --- Privacy --------------------------------------------------------
# Salt for hashing medical record numbers. Generate with:
#   openssl rand -hex 32
# The API refuses to start in production while this is left at its default.
# Rotating it re-pseudonymises every patient and destroys longitudinal
# linkage (readmission rates reset to zero). Treat it as permanent.
HPF_MRN_SALT=dev-only-insecure-salt

# --- Locale ---------------------------------------------------------
HPF_FACILITY_TIMEZONE=Asia/Riyadh
HPF_DEFAULT_LOCALE=en

# --- Ingestion ------------------------------------------------------
HPF_MAX_UPLOAD_MB=100
HPF_MIN_QUALITY_SCORE_TO_LOAD=60
HPF_UPLOAD_DIR=./var/uploads
HPF_MODEL_DIR=./var/models

# --- Web ------------------------------------------------------------
HPF_CORS_ORIGINS=["http://localhost:3000"]
# Inlined into the frontend bundle at BUILD time, not runtime.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Compose only ---------------------------------------------------
POSTGRES_PASSWORD=change-me-in-production
